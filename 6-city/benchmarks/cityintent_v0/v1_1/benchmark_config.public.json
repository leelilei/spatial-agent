  "metrics": [
    {"id": "task_completion"}, {"id": "constraint_satisfaction"},
    {"id": "goal_completion"}, {"id": "process_success"},
    {"id": "feasibility_violation"}, {"id": "replanning_success"},
    {"id": "travel_efficiency"}, {"id": "budget_consistency"},
    {"id": "intention_consistency"}, {"id": "social_appropriateness"}
