{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cityintent.example/schema/submission-episode-v1.json",
  "title": "CityIntent v1.1 submission episode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "benchmark_version",
    "split_hash",
    "system",
    "actor_model",
    "provider",
    "action_interface",
    "telemetry",
    "disclosure",
    "actions"
  ],
  "properties": {
    "scenario_id": {"type": "string", "minLength": 1},
    "benchmark_version": {"const": "1.1.0"},
    "split_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "system": {"type": "object", "required": ["name", "version"], "additionalProperties": false, "properties": {"name": {"type": "string"}, "version": {"type": "string"}}},
    "actor_model": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "action_interface": {"type": "string", "minLength": 1},
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calls", "input_tokens", "output_tokens", "latency_seconds", "retries"],
      "properties": {
        "calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "latency_seconds": {"type": "number", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0}
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_memory", "retrieval", "fine_tuning", "human_input"],
      "properties": {
        "external_memory": {"type": "boolean"},
        "retrieval": {"type": "boolean"},
        "fine_tuning": {"type": "boolean"},
        "human_input": {"type": "boolean"}
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {"enum": ["recall", "move", "enter", "use_service", "buy", "dwell", "message", "interact", "finish", "abandon"]},
          "target": {"type": ["string", "null"]},
          "path": {"type": ["array", "null"], "items": {"type": "string"}},
          "minutes": {"type": "integer", "minimum": 0},
          "to": {"type": ["string", "null"]},
          "content": {"type": "string"},
          "item": {"type": "string"},
          "service": {"type": "string"},
          "query": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
