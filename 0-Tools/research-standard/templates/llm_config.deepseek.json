{
  "provider": "deepseek",
  "model": "deepseek-v4-flash",
  "wire_api": "chat_completions",
  "base_url": "https://yunwu.ai",
  "api_key_env": "DEEPSEEK_API_KEY",
  "temperature": 0,
  "omit_temperature": false,
  "timeout": 120,
  "sleep": 0,
  "max_concurrency": 1,
  "retries": 2,
  "retry_sleep": 3,
  "json_mode": true,
  "transport": "urllib"
}
