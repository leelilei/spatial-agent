{
  "provider": "openai",
  "model": "MODEL_VERSION_TO_PIN",
  "wire_api": "responses",
  "base_url": "https://api.openai.com",
  "temperature": 0,
  "omit_temperature": false,
  "timeout": 120,
  "sleep": 0,
  "max_concurrency": 1,
  "retries": 2,
  "retry_sleep": 3,
  "json_mode": true,
  "transport": "urllib",
  "responses_input_mode": "messages",
  "disable_response_storage": true
}
