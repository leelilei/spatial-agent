\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Figure 2. PRISMA-ScR screening and evidence-map stabilization flow. The bibliographic screening stage starts from `417` screened records and separates `Core`, `Adjacent`, `Foundational`, and excluded records. The evidence-map stage then operates at the `system / environment configuration` level, preserving the strict `anchor\_core` baseline while adding selected `bridge\_core` rows under widened scope rules. Counts therefore differ by layer: the final stable widened Core contains `32` paper-level sources and `34` coded rows. `HC01` and `TW-02` are retained as boundary materials rather than counted in the stable widened-Core evidence map; `BK02` remains a source-note-only bridge row until resolved.}}{6}{figure.caption.5}\protected@file@percent }
\newlabel{fig:2}{{3}{6}{Figure 2. PRISMA-ScR screening and evidence-map stabilization flow. The bibliographic screening stage starts from `417` screened records and separates `Core`, `Adjacent`, `Foundational`, and excluded records. The evidence-map stage then operates at the `system / environment configuration` level, preserving the strict `anchor\_core` baseline while adding selected `bridge\_core` rows under widened scope rules. Counts therefore differ by layer: the final stable widened Core contains `32` paper-level sources and `34` coded rows. `HC01` and `TW-02` are retained as boundary materials rather than counted in the stable widened-Core evidence map; `BK02` remains a source-note-only bridge row until resolved}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}3.2 Spatial Representation Taxonomy: L0-L5}{6}{subsection.3.2}\protected@file@percent }
\newlabel{spatial-representation-taxonomy-l0-l5}{{3.2}{6}{3.2 Spatial Representation Taxonomy: L0-L5}{subsection.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Figure 3. Agent-accessible spatial representation taxonomy used in the evidence map. Levels code what the agent can consume, not what the environment stores or what the analyst computes after the simulation. The stable widened Core is concentrated at `L3`, while `L4` appears only once and only in a widened digital-network bridge case. `L5` indicates geometry-bearing or embodied input, not automatic configurational mediation. This supports the interpretation of configurational or globally abstract agent-facing structure as an underexplored design space rather than a validated field-wide layer.}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:3}{{4}{7}{Figure 3. Agent-accessible spatial representation taxonomy used in the evidence map. Levels code what the agent can consume, not what the environment stores or what the analyst computes after the simulation. The stable widened Core is concentrated at `L3`, while `L4` appears only once and only in a widened digital-network bridge case. `L5` indicates geometry-bearing or embodied input, not automatic configurational mediation. This supports the interpretation of configurational or globally abstract agent-facing structure as an underexplored design space rather than a validated field-wide layer}{figure.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}3.3 Main Evidence Map}{7}{subsection.3.3}\protected@file@percent }
